{
  "name": "bossdaddy-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/check-middleware-convention.mjs",
    "build": "next build",
    "prebuild": "node scripts/check-middleware-convention.mjs && node scripts/check-og-coverage.mjs && node scripts/check-jsx-spaces.mjs && node scripts/check-storage-upload-body.mjs && node scripts/check-prose-invert.mjs && node scripts/check-invisible-shadow.mjs && node scripts/check-color-roles.mjs && node scripts/check-goals-identity.mjs",
    "start": "next start",
    "lint": "eslint --cache",
    "check": "tsc --noEmit && eslint --cache",
    "check:full": "tsc --noEmit && eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:middleware": "node scripts/check-middleware-convention.mjs",
    "check:og": "node scripts/check-og-coverage.mjs",
    "check:jsx-spaces": "node scripts/check-jsx-spaces.mjs",
    "check:upload-body": "node scripts/check-storage-upload-body.mjs",
    "check:prose-invert": "node scripts/check-prose-invert.mjs",
    "check:shadow": "node scripts/check-invisible-shadow.mjs",
    "check:color-roles": "node scripts/check-color-roles.mjs",
    "check:goals-identity": "node scripts/check-goals-identity.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "db:push": "supabase db push",
    "test:rls": "supabase test db",
    "test:e2e": "playwright test",
    "e2e:accounts": "node --env-file=.env.local e2e/setup-accounts.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke-test.mjs",
    "ai:smoke": "node --env-file=.env.local scripts/ai-smoke.mjs",
    "ai:drift": "node --env-file=.env.local scripts/ai-model-drift.mjs",
    "ai:ab-utility": "node --env-file=.env.local scripts/ai-utility-ab.mjs",
    "ai:probe-thinking": "node --env-file=.env.local scripts/ai-thinking-probe.mjs",
    "ai:ab-content": "node --env-file=.env.local scripts/ai-content-quality-ab.mjs",
    "ai:which": "node --env-file=.env.local scripts/which-research-model.mjs",
    "ai:probe-retrieval": "node --env-file=.env.local scripts/retrieval-probe.mjs",
    "ai:drift:ci": "node scripts/ai-model-drift.mjs",
    "ai:research-smoke": "node --env-file=.env.local scripts/ai-research-smoke.mjs",
    "embed:smoke": "node --env-file=.env.local scripts/embed-smoke.mjs",
    "embed:content": "node --env-file=.env.local scripts/embed-content.mjs",
    "hybrid:smoke": "node --env-file=.env.local scripts/hybrid-smoke.mjs",
    "boss:eval": "vitest run --config vitest.eval.config.ts",
    "merch:sync": "node --env-file=.env.local scripts/sync-printful.mjs",
    "merch:discover": "node --env-file=.env.local scripts/discover-merch-blanks.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.99",
    "@ai-sdk/xai": "^3.0.111",
    "@anthropic-ai/sdk": "^0.115.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-character-count": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@types/web-push": "^3.6.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.230",
    "next": "^16.2.12",
    "openai": "^6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.18.0",
    "rrule-temporal": "2.0.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3",
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    },
    "brace-expansion@5": "^5.0.8"
  },
  "browserslist": [
    "Chrome >= 100",
    "Edge >= 100",
    "Firefox >= 100",
    "Safari >= 15.4",
    "iOS >= 15.4",
    "not dead",
    "not op_mini all"
  ]
}
